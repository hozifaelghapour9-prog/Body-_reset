
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BodyReset | Progress</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:20px;font-family:Arial,sans-serif;background:#073b40;color:#fff}
header,main{max-width:950px;margin:20px auto}
header{display:flex;justify-content:space-between;align-items:center;gap:12px}
a{color:#65e6d4;text-decoration:none}
.card{background:#104f54;border:1px solid #24777a;border-radius:18px;padding:20px;margin:18px 0}
h1,h2{margin-top:0}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.stat{background:#083f44;padding:16px;border-radius:12px}
.stat span{display:block;color:#a8d5d3;font-size:14px}
.stat strong{display:block;font-size:24px;margin-top:10px}
form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
label{display:block;font-size:14px}
input,textarea{width:100%;margin-top:7px;padding:12px;border-radius:9px;border:1px solid #39858a;background:#073b40;color:white;font:inherit}
button{padding:12px 16px;border:0;border-radius:9px;background:#31d6bd;color:#06383b;font-weight:bold;font-size:15px;cursor:pointer}
button.delete{background:#ffdddd;color:#8a1616}
.full{grid-column:1/-1}
canvas{width:100%;height:240px;display:block}
.record{padding:14px;border:1px solid #398085;border-radius:12px;margin-top:12px;overflow-wrap:anywhere}
.record p{color:#c2e4e1;line-height:1.8}
.actions{display:flex;gap:8px;flex-wrap:wrap}
.actions button{font-size:13px;padding:9px}
.photos{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:12px;margin-top:15px}
.photo{padding:8px;border:1px solid #398085;border-radius:12px;overflow:hidden}
.photo img{width:100%;height:150px;object-fit:cover;border-radius:8px}
small{color:#b7d9d6;line-height:1.8}
.empty{color:#b7d9d6;text-align:center;padding:20px}
@media(max-width:550px){body{padding:12px}.stats{grid-template-columns:1fr}form{grid-template-columns:1fr}.full{grid-column:auto}.card{padding:15px}}
</style>
</head>
<body>
<header>
  <h1>📊 Progress</h1>
  <a href="index.html">← الرئيسية</a>
</header>

<main>
  <section class="stats">
    <div class="stat"><span>آخر وزن</span><strong id="current">--</strong></div>
    <div class="stat"><span>تغير الوزن</span><strong id="change">--</strong></div>
    <div class="stat"><span>عدد التسجيلات</span><strong id="count">0</strong></div>
  </section>

  <section class="card">
    <h2>➕ سجل تقدمك</h2>
    <form id="form">
      <label>التاريخ<input type="date" id="date" required></label>
      <label>الوزن (كجم)<input type="number" id="weight" min="1" max="500" step="0.1" required placeholder="75.5"></label>
      <label>نسبة الدهون (%)<input type="number" id="fat" min="0" max="100" step="0.1"></label>
      <label>محيط الخصر (سم)<input type="number" id="waist" min="1" step="0.1"></label>
      <label>محيط الصدر (سم)<input type="number" id="chest" min="1" step="0.1"></label>
      <label>محيط الذراع (سم)<input type="number" id="arm" min="1" step="0.1"></label>
      <label>محيط الفخذ (سم)<input type="number" id="thigh" min="1" step="0.1"></label>
      <label class="full">ملاحظات<textarea id="notes" rows="3" placeholder="اكتب ملاحظاتك..."></textarea></label>
      <button class="full" id="submit" type="submit">حفظ التقدم</button>
      <button class="full" id="cancel" type="button" hidden>إلغاء التعديل</button>
    </form>
    <small>بياناتك تُحفظ في المتصفح على هذا الجهاز.</small>
  </section>

  <section class="card">
    <h2>📈 رسم تطور الوزن</h2>
    <canvas id="chart"></canvas>
  </section>

  <section class="card">
    <h2>📷 صور التقدم</h2>
    <label>اختر صورة<input type="file" id="photoFile" accept="image/*"></label>
    <label style="display:block;margin-top:12px">تاريخ الصورة<input type="date" id="photoDate"></label>
    <button type="button" id="addPhoto" style="margin-top:12px">إضافة الصورة</button>
    <div class="photos" id="photos"></div>
  </section>

  <section class="card">
    <h2>🗓️ سجل التقدم</h2>
    <div id="records"></div>
    <div class="actions" style="margin-top:15px">
      <button type="button" id="export">تصدير نسخة احتياطية</button>
      <button type="button" id="importBtn">استيراد نسخة</button>
      <input type="file" id="importFile" accept=".json,application/json" hidden>
    </div>
  </section>
</main>

<script>
(() => {
  const KEY = "bodyreset_progress_v1";
  const PHOTO_KEY = "bodyreset_progress_photos_v1";
  const $ = id => document.getElementById(id);

  function read(key) {
    try {
      const data = JSON.parse(localStorage.getItem(key) || "[]");
      return Array.isArray(data) ? data : [];
    } catch { return []; }
  }

  let records = read(KEY);
  let photos = read(PHOTO_KEY);
  let editing = null;
  let selectedPhoto = null;

  const today = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
  };

  const val = id => $(id).value.trim();
  const num = id => val(id) === "" ? null : Number(val(id));
  const fmt = n => n == null ? "—" : Number(n).toLocaleString("ar-EG");
  const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2);
  const safe = s => String(s ?? "").replace(/[&<>"']/g, c => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[c]);

  function save() {
    localStorage.setItem(KEY, JSON.stringify(records));
    localStorage.setItem(PHOTO_KEY, JSON.stringify(photos));
  }

  function sorted() {
    return [...records].sort((a,b) => a.date.localeCompare(b.date));
  }

  function renderStats() {
    const list = sorted();
    $("count").textContent = list.length;
    if (!list.length) {
      $("current").textContent = "--";
      $("change").textContent = "--";
      return;
    }
    $("current").textContent = fmt(list[list.length-1].weight) + " كجم";
    const diff = list[list.length-1].weight - list[0].weight;
    $("change").textContent = (diff > 0 ? "+" : "") + fmt(Math.round(diff*10)/10) + " كجم";
  }

  function drawChart() {
    const canvas = $("chart");
    const ctx = canvas.getContext("2d");
    const w = canvas.clientWidth || 300, h = 240;
    const ratio = window.devicePixelRatio || 1;
    canvas.width = w * ratio;
    canvas.height = h * ratio;
    ctx.setTransform(ratio,0,0,ratio,0,0);
    ctx.clearRect(0,0,w,h);

    const list = sorted();
    if (!list.length) {
      ctx.fillStyle = "#b7d9d6";
      ctx.font = "15px Arial";
      ctx.textAlign = "center";
      ctx.fillText("سجّل وزنك عشان يظهر الرسم",w/2,h/2);
      return;
    }

    const values = list.map(x => Number(x.weight));
    const min = Math.min(...values), max = Math.max(...values);
    const margin = Math.max(2,(max-min)*0.25);
    const low = min-margin, high = max+margin;
    const left = 38, right = 18, top = 22, bottom = 35;
    const pw = Math.max(1,w-left-right), ph = h-top-bottom;

    ctx.font = "11px Arial";
    ctx.textAlign = "left";
    for(let i=0;i<4;i++){
      const y = top+ph*i/3;
      ctx.strokeStyle = "#28676a";
      ctx.beginPath();ctx.moveTo(left,y);ctx.lineTo(w-right,y);ctx.stroke();
      ctx.fillStyle = "#b7d9d6";
      ctx.fillText((high-(high-low)*i/3).toFixed(1),2,y-4);
    }

    const pts = values.map((v,i)=>({
      x: list.length===1 ? w/2 : left+pw*i/(list.length-1),
      y: top+(high-v)/(high-low)*ph
    }));

    ctx.strokeStyle = "#31d6bd";
    ctx.lineWidth = 3;
    ctx.beginPath();
    pts.forEach((p,i)=>i ? ctx.lineTo(p.x,p.y) : ctx.moveTo(p.x,p.y));
    ctx.stroke();

    pts.forEach(p=>{
      ctx.fillStyle="#31d6bd";
      ctx.beginPath();ctx.arc(p.x,p.y,4,0,Math.PI*2);ctx.fill();
    });

    ctx.fillStyle="#b7d9d6";
    ctx.textAlign="center";
    ctx.fillText(list[0].date,pts[0].x,h-10);
    if(list.length>1)ctx.fillText(list[list.length-1].date,pts[pts.length-1].x,h-10);
  }

  function renderRecords() {
    const box = $("records");
    const list = [...records].sort((a,b)=>b.date.localeCompare(a.date));
    if(!list.length){
      box.innerHTML='<div class="empty">لسه مفيش تسجيلات. ابدأ سجل تقدمك 💪</div>';
      return;
    }

    box.innerHTML = list.map(r=>`
      <article class="record">
        <strong>${safe(r.date)} — ${fmt(r.weight)} كجم</strong>
        <p>
          الدهون: ${fmt(r.fat)}% · الخصر: ${fmt(r.waist)} سم · الصدر: ${fmt(r.chest)} سم<br>
          الذراع: ${fmt(r.arm)} سم · الفخذ: ${fmt(r.thigh)} سم<br>
          ${safe(r.notes || "بدون ملاحظات")}
        </p>
        <div class="actions">
          <button type="button" data-edit="${r.id}">تعديل</button>
          <button type="button" class="delete" data-delete="${r.id}">حذف</button>
        </div>
      </article>`).join("");
  }

  function renderPhotos() {
    $("photos").innerHTML = photos.length ? photos.map(p=>`
      <div class="photo">
        <img src="${p.data}" alt="صورة تقدم ${safe(p.date)}">
        <p>${safe(p.date)}</p>
        <button type="button" class="delete" data-photo="${p.id}">حذف الصورة</button>
      </div>`).join("") : '<p class="empty">مفيش صور لحد دلوقتي.</p>';
  }

  function render() {
    renderStats();
    renderRecords();
    renderPhotos();
    drawChart();
  }

  function reset() {
    editing = null;
    $("form").reset();
    $("date").value = today();
    $("submit").textContent = "حفظ التقدم";
    $("cancel").hidden = true;
  }

  $("form").addEventListener("submit", e=>{
    e.preventDefault();
    const weight = num("weight");
    if(!val("date") || !Number.isFinite(weight) || weight<=0){
      alert("اكتب تاريخ ووزن صحيح.");
      return;
    }

    const entry = {
      id: editing || uid(),
      date: val("date"),
      weight,
      fat: num("fat"),
      waist: num("waist"),
      chest: num("chest"),
      arm: num("arm"),
      thigh: num("thigh"),
      notes: val("notes")
    };

    const old = records;
    records = editing
      ? records.map(r=>r.id===editing ? entry : r)
      : [...records,entry];

    try {
      localStorage.setItem(KEY,JSON.stringify(records));
      reset();
      render();
    } catch {
      records=old;
      alert("مساحة التخزين ممتلئة، تعذّر حفظ البيانات.");
    }
  });

  $("cancel").addEventListener("click",reset);

  $("records").addEventListener("click",e=>{
    const edit = e.target.closest("[data-edit]");
    const del = e.target.closest("[data-delete]");

    if(edit){
      const r=records.find(x=>x.id===edit.dataset.edit);
      if(!r)return;
      editing=r.id;
      ["date","weight","fat","waist","chest","arm","thigh","notes"]
        .forEach(k=>$(k).value=r[k] ?? "");
      $("submit").textContent="حفظ التعديلات";
      $("cancel").hidden=false;
      $("form").scrollIntoView({behavior:"smooth"});
    }

    if(del && confirm("متأكد إنك عايز تحذف التسجيل؟")){
      const old=records;
      records=records.filter(r=>r.id!==del.dataset.delete);
      try{localStorage.setItem(KEY,JSON.stringify(records));render();}
      catch{records=old;alert("تعذّر الحفظ.");}
    }
  });

  $("photoDate").value=today();
  $("photoFile").addEventListener("change",e=>selectedPhoto=e.target.files[0]||null);

  $("addPhoto").addEventListener("click",()=>{
    if(!selectedPhoto){alert("اختار صورة الأول.");return;}
    if(!selectedPhoto.type.startsWith("image/")){alert("اختار صورة صحيحة.");return;}
    if(selectedPhoto.size>12*1024*1024){alert("اختار صورة أقل من 12 ميجابايت.");return;}

    const reader=new FileReader();
    reader.onload=()=>{
      const img=new Image();
      img.onload=()=>{
        const c=document.createElement("canvas");
        const scale=Math.min(1,1000/Math.max(img.width,img.height));
        c.width=Math.round(img.width*scale);
        c.height=Math.round(img.height*scale);
        c.getContext("2d").drawImage(img,0,0,c.width,c.height);

        const old=photos;
        photos=[...photos,{
          id:uid(),
          date:val("photoDate")||today(),
          data:c.toDataURL("image/jpeg",0.75)
        }];

        try{
          localStorage.setItem(PHOTO_KEY,JSON.stringify(photos));
          selectedPhoto=null;
          $("photoFile").value="";
          renderPhotos();
        }catch{
          photos=old;
          alert("مساحة الصور ممتلئة. احذف بعض الصور وحاول تاني.");
        }
      };
      img.onerror=()=>alert("تعذرت قراءة الصورة.");
      img.src=reader.result;
    };
    reader.readAsDataURL(selectedPhoto);
  });

  $("photos").addEventListener("click",e=>{
    const b=e.target.closest("[data-photo]");
    if(!b||!confirm("تحذف الصورة؟"))return;
    const old=photos;
    photos=photos.filter(p=>p.id!==b.dataset.photo);
    try{localStorage.setItem(PHOTO_KEY,JSON.stringify(photos));renderPhotos();}
    catch{photos=old;alert("تعذّر الحفظ.");}
  });

  $("export").addEventListener("click",()=>{
    const blob=new Blob([JSON.stringify({records,photos},null,2)],{type:"application/json"});
    const url=URL.createObjectURL(blob);
    const a=document.createElement("a");
    a.href=url;a.download="bodyreset-progress.json";a.click();
    setTimeout(()=>URL.revokeObjectURL(url),1000);
  });

  $("importBtn").addEventListener("click",()=>$("importFile").click());
  $("importFile").addEventListener("change",async e=>{
    const file=e.target.files[0];
    if(!file)return;
    try{
      const data=JSON.parse(await file.text());
      if(!Array.isArray(data.records)||!Array.isArray(data.photos))throw Error();
      if(!confirm("النسخة هتستبدل بياناتك الحالية. تكمل؟"))return;
      const oldR=records,oldP=photos;
      records=data.records;photos=data.photos;
      try{
        localStorage.setItem(KEY,JSON.stringify(records));
        localStorage.setItem(PHOTO_KEY,JSON.stringify(photos));
        render();
        alert("تم استيراد النسخة بنجاح.");
      }catch{
        records=oldR;photos=oldP;
        localStorage.setItem(KEY,JSON.stringify(records));
        localStorage.setItem(PHOTO_KEY,JSON.stringify(photos));
        throw Error();
      }
    }catch{alert("ملف النسخة غير صالح أو مساحة التخزين ممتلئة.");}
    finally{e.target.value="";}
  });

  window.addEventListener("resize",drawChart);
  reset();
  render();
})();
</script>
</body>
</html>
