<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BodyReset | Progress</title>

<style>
*{box-sizing:border-box}
body{margin:0;padding:20px;font-family:Arial,sans-serif;background:#073b40;color:#fff}
header,main{max-width:950px;margin:20px auto}
header{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
a{color:#65e6d4;text-decoration:none}
.card{background:#104f54;border:1px solid #24777a;border-radius:18px;padding:20px;margin:18px 0}
h1,h2{margin-top:0}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:20px}
.stat{background:#083f44;padding:16px;border-radius:12px;min-width:0}
.stat span{display:block;color:#a8d5d3;font-size:14px}
.stat strong{display:block;font-size:24px;margin-top:10px;overflow-wrap:anywhere}
form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
label{display:block;font-size:14px}
input,textarea{width:100%;min-width:0;margin-top:7px;padding:12px;border-radius:9px;border:1px solid #39858a;background:#073b40;color:white;font:inherit}
input[type=file]{padding:8px}
input:focus,textarea:focus{outline:2px solid #31d6bd;outline-offset:2px}
button{padding:12px 16px;border:0;border-radius:9px;background:#31d6bd;color:#06383b;font-weight:bold;font-size:15px;cursor:pointer}
button:disabled{opacity:.55;cursor:not-allowed}
button.delete{background:#ffdddd;color:#8a1616}
.full{grid-column:1/-1}
canvas{width:100%;height:240px;display:block}
.record{padding:14px;border:1px solid #398085;border-radius:12px;margin-top:12px;overflow-wrap:anywhere}
.record p{color:#c2e4e1;line-height:1.8}
.actions{display:flex;gap:8px;flex-wrap:wrap}
.actions button{font-size:13px;padding:9px}
.photos{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:12px;margin-top:15px}
.photo{padding:8px;border:1px solid #398085;border-radius:12px;overflow:hidden;min-width:0}
.photo img{width:100%;height:150px;object-fit:cover;border-radius:8px}
small{color:#b7d9d6;line-height:1.8}
.empty{color:#b7d9d6;text-align:center;padding:20px}
.notice{padding:12px;border-radius:10px;background:#083f44;color:#c2e4e1;line-height:1.8}
[hidden]{display:none!important}
@media(max-width:550px){
 body{padding:12px}
 .stats{grid-template-columns:1fr}
 form{grid-template-columns:1fr}
 .full{grid-column:auto}
 .card{padding:15px}
 header h1{font-size:24px}
}
</style>
</head>

<body>
<header>
  <h1>📊 Progress</h1>
  <a href="index.html">← الرئيسية</a>
</header>

<main>
  <section class="stats">
    <div class="stat"><span>آخر وزن مسجل</span><strong id="current">—</strong></div>
    <div class="stat"><span>تغير الوزن</span><strong id="change">—</strong></div>
    <div class="stat"><span>عدد التسجيلات</span><strong id="count">0</strong></div>
  </section>

  <section class="card">
    <h2>➕ سجل تقدمك</h2>
    <form id="form">
      <label>التاريخ
        <input type="date" id="date" required>
      </label>
      <label>الوزن (كجم)
        <input type="number" id="weight" min="1" max="500" step="0.1" required placeholder="75.5">
      </label>
      <label>نسبة الدهون (%)
        <input type="number" id="fat" min="0" max="100" step="0.1">
      </label>
      <label>محيط الخصر (سم)
        <input type="number" id="waist" min="1" max="500" step="0.1">
      </label>
      <label>محيط الصدر (سم)
        <input type="number" id="chest" min="1" max="500" step="0.1">
      </label>
      <label>محيط الذراع (سم)
        <input type="number" id="arm" min="1" max="200" step="0.1">
      </label>
      <label>محيط الفخذ (سم)
        <input type="number" id="thigh" min="1" max="300" step="0.1">
      </label>
      <label class="full">ملاحظات
        <textarea id="notes" rows="3" maxlength="3000" placeholder="اكتب ملاحظاتك..."></textarea>
      </label>
      <button class="full" id="submit" type="submit">حفظ التقدم</button>
      <button class="full" id="cancel" type="button" hidden>إلغاء التعديل</button>
    </form>
    <small>بياناتك محفوظة محليًا في المتصفح على هذا الجهاز. يُنصح بتصدير نسخة احتياطية دوريًا.</small>
  </section>

  <section class="card">
    <h2>📈 رسم تطور الوزن</h2>
    <canvas id="chart" role="img" aria-label="رسم بياني لتطور الوزن"></canvas>
  </section>

  <section class="card">
    <h2>📷 صور التقدم</h2>
    <label>اختر صورة
      <input type="file" id="photoFile" accept="image/*">
    </label>
    <label style="display:block;margin-top:12px">تاريخ الصورة
      <input type="date" id="photoDate">
    </label>
    <button type="button" id="addPhoto" style="margin-top:12px">إضافة الصورة</button>
    <p class="notice">يتم تصغير الصور قبل حفظها لتقليل استهلاك مساحة المتصفح.</p>
    <div class="photos" id="photos"></div>
  </section>

  <section class="card">
    <h2>🗓️ سجل التقدم</h2>
    <div id="records"></div>
    <div class="actions" style="margin-top:15px">
      <button type="button" id="export">تصدير نسخة احتياطية</button>
      <button type="button" id="importBtn">استيراد نسخة</button>
      <input type="file" id="importFile" accept=".json,application/json" hidden>
    </div>
  </section>
</main>

<script>
(() => {
  "use strict";

  const KEY = "bodyreset_progress_v1";
  const PHOTO_KEY = "bodyreset_progress_photos_v1";
  const $ = id => document.getElementById(id);

  let records = read(KEY);
  let photos = read(PHOTO_KEY);
  let editing = null;
  let selectedPhoto = null;

  function read(key) {
    try {
      const value = JSON.parse(localStorage.getItem(key) || "[]");
      return Array.isArray(value) ? value : [];
    } catch (error) {
      console.error("Could not read saved data:", error);
      return [];
    }
  }

  function today() {
    const d = new Date();
    return [
      d.getFullYear(),
      String(d.getMonth() + 1).padStart(2, "0"),
      String(d.getDate()).padStart(2, "0")
    ].join("-");
  }

  const val = id => $(id).value.trim();
  const num = id => val(id) === "" ? null : Number(val(id));
  const fmt = n => n == null || !Number.isFinite(Number(n))
    ? "—"
    : Number(n).toLocaleString("ar-EG", { maximumFractionDigits: 1 });

  const uid = () =>
    Date.now().toString(36) + Math.random().toString(36).slice(2);

  const safe = s => String(s ?? "").replace(/[&<>"']/g, c => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[c]);

  function validDate(s) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(String(s))) return false;
    const d = new Date(s + "T00:00:00Z");
    return !Number.isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s;
  }

  function persistRecords(next) {
    try {
      localStorage.setItem(KEY, JSON.stringify(next));
      records = next;
      return true;
    } catch (error) {
      console.error(error);
      alert("تعذّر حفظ التسجيل. مساحة المتصفح قد تكون ممتلئة.");
      return false;
    }
  }

  function persistPhotos(next) {
    try {
      localStorage.setItem(PHOTO_KEY, JSON.stringify(next));
      photos = next;
      return true;
    } catch (error) {
      console.error(error);
      alert("تعذّر حفظ الصورة. احذف بعض الصور أو صدّر نسخة احتياطية.");
      return false;
    }
  }

  function sorted() {
    return [...records].sort((a, b) => a.date.localeCompare(b.date));
  }

  function renderStats() {
    const list = sorted();
    $("count").textContent = list.length;

    if (!list.length) {
      $("current").textContent = "—";
      $("change").textContent = "—";
      return;
    }

    $("current").textContent = fmt(list[list.length - 1].weight) + " كجم";
    const diff = Number(list[list.length - 1].weight) - Number(list[0].weight);
    $("change").textContent =
      (diff > 0 ? "+" : "") + fmt(diff) + " كجم";
  }

  function drawChart() {
    const canvas = $("chart");
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const w = Math.max(280, canvas.clientWidth || 300);
    const h = 240;
    const ratio = Math.min(window.devicePixelRatio || 1, 2);

    canvas.width = Math.round(w * ratio);
    canvas.height = Math.round(h * ratio);
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    ctx.clearRect(0, 0, w, h);

    const list = sorted().filter(r => Number.isFinite(Number(r.weight)));

    if (!list.length) {
      ctx.fillStyle = "#b7d9d6";
      ctx.font = "15px Arial";
      ctx.textAlign = "center";
      ctx.fillText("سجّل وزنك عشان يظهر الرسم", w / 2, h / 2);
      return;
    }

    const values = list.map(r => Number(r.weight));
    const min = Math.min(...values);
    const max = Math.max(...values);
    const margin = Math.max(1, (max - min) * 0.2);
    const low = Math.max(0, min - margin);
    const high = max + margin;

    const left = 42, right = 18, top = 22, bottom = 38;
    const pw = Math.max(1, w - left - right);
    const ph = h - top - bottom;

    ctx.font = "11px Arial";
    ctx.textAlign = "left";

    for (let i = 0; i < 4; i++) {
      const y = top + ph * i / 3;
      ctx.strokeStyle = "#28676a";
      ctx.beginPath();
      ctx.moveTo(left, y);
      ctx.lineTo(w - right, y);
      ctx.stroke();

      ctx.fillStyle = "#b7d9d6";
      const label = (high - (high - low) * i / 3).toFixed(1);
      ctx.fillText(label, 2, y - 4);
    }

    const points = values.map((v, i) => ({
      x: list.length === 1 ? left + pw / 2 : left + pw * i / (list.length - 1),
      y: top + (high - v) / (high - low || 1) * ph
    }));

    ctx.strokeStyle = "#31d6bd";
    ctx.lineWidth = 3;
    ctx.beginPath();
    points.forEach((p, i) => i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y));
    ctx.stroke();

    points.forEach((p, i) => {
      ctx.fillStyle = "#31d6bd";
      ctx.beginPath();
      ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
      ctx.fill();

      if (list.length <= 8) {
        ctx.fillStyle = "#ffffff";
        ctx.textAlign = "center";
        ctx.fillText(fmt(values[i]), p.x, Math.max(12, p.y - 10));
      }
    });

    ctx.fillStyle = "#b7d9d6";
    ctx.textAlign = "center";
    ctx.fillText(list[0].date, points[0].x, h - 10);

    if (list.length > 1) {
      ctx.fillText(list[list.length - 1].date, points[points.length - 1].x, h - 10);
    }
  }

  function renderRecords() {
    const box = $("records");
    const list = [...records].sort((a, b) => b.date.localeCompare(a.date));

    if (!list.length) {
      box.innerHTML = '<div class="empty">لسه مفيش تسجيلات. ابدأ سجل تقدمك 💪</div>';
      return;
    }

    box.innerHTML = list.map(r => `
      <article class="record">
        <strong>${safe(r.date)} — ${fmt(r.weight)} كجم</strong>
        <p>
          الدهون: ${fmt(r.fat)}% · الخصر: ${fmt(r.waist)} سم · الصدر: ${fmt(r.chest)} سم<br>
          الذراع: ${fmt(r.arm)} سم · الفخذ: ${fmt(r.thigh)} سم<br>
          ${safe(r.notes || "بدون ملاحظات")}
        </p>
        <div class="actions">
          <button type="button" data-edit="${safe(r.id)}">تعديل</button>
          <button type="button" class="delete" data-delete="${safe(r.id)}">حذف</button>
        </div>
      </article>
    `).join("");
  }

  function renderPhotos() {
    $("photos").innerHTML = photos.length
      ? photos.map(p => `
        <div class="photo">
          <img src="${p.data}" alt="صورة تقدم ${safe(p.date)}" loading="lazy">
          <p>${safe(p.date)}</p>
          <button type="button" class="delete" data-photo="${safe(p.id)}">حذف الصورة</button>
        </div>
      `).join("")
      : '<p class="empty">مفيش صور لحد دلوقتي.</p>';
  }

  function render() {
    renderStats();
    renderRecords();
    renderPhotos();
    drawChart();
  }

  function reset() {
    editing = null;
    $("form").reset();
    $("date").value = today();
    $("submit").textContent = "حفظ التقدم";
    $("cancel").hidden = true;
  }

  function validMeasurement(id, min, max) {
    const value = num(id);
    if (value === null) return true;
    return Number.isFinite(value) && value >= min && value <= max;
  }

  $("form").addEventListener("submit", e => {
    e.preventDefault();

    const date = val("date");
    const weight = num("weight");

    if (!validDate(date) || !Number.isFinite(weight) || weight < 1 || weight > 500) {
      alert("اكتب تاريخ ووزن صحيحين.");
      return;
    }

    const limits = {
      fat: [0, 100],
      waist: [1, 500],
      chest: [1, 500],
      arm: [1, 200],
      thigh: [1, 300]
    };

    for (const [id, range] of Object.entries(limits)) {
      if (!validMeasurement(id, range[0], range[1])) {
        alert("راجع قيمة: " + ({
          fat: "نسبة الدهون",
          waist: "محيط الخصر",
          chest: "محيط الصدر",
          arm: "محيط الذراع",
          thigh: "محيط الفخذ"
        })[id]);
        return;
      }
    }

    const entry = {
      id: editing || uid(),
      date,
      weight,
      fat: num("fat"),
      waist: num("waist"),
      chest: num("chest"),
      arm: num("arm"),
      thigh: num("thigh"),
      notes: val("notes")
    };

    const duplicate = records.find(r => r.date === date && r.id !== editing);
    if (duplicate) {
      alert("فيه تسجيل موجود بالتاريخ ده. استخدم زر تعديل لتحديثه.");
      return;
    }

    const next = editing
      ? records.map(r => r.id === editing ? entry : r)
      : [...records, entry];

    if (persistRecords(next)) {
      reset();
      render();
      alert("تم حفظ التقدم بنجاح.");
    }
  });

  $("cancel").addEventListener("click", reset);

  $("records").addEventListener("click", e => {
    const edit = e.target.closest("[data-edit]");
    const del = e.target.closest("[data-delete]");

    if (edit) {
      const r = records.find(x => x.id === edit.dataset.edit);
      if (!r) return;

      editing = r.id;
      ["date", "weight", "fat", "waist", "chest", "arm", "thigh", "notes"]
        .forEach(k => $(k).value = r[k] ?? "");

      $("submit").textContent = "حفظ التعديلات";
      $("cancel").hidden = false;
      $("form").scrollIntoView({ behavior: "smooth", block: "start" });
    }

    if (del && confirm("متأكد إنك عايز تحذف التسجيل؟")) {
      const next = records.filter(r => r.id !== del.dataset.delete);
      if (persistRecords(next)) {
        if (editing === del.dataset.delete) reset();
        render();
      }
    }
  });

  $("photoDate").value = today();

  $("photoFile").addEventListener("change", e => {
    selectedPhoto = e.target.files[0] || null;
  });

  $("addPhoto").addEventListener("click", () => {
    if (!selectedPhoto) {
      alert("اختار صورة الأول.");
      return;
    }

    if (!selectedPhoto.type.startsWith("image/")) {
      alert("اختار ملف صورة صحيح.");
      return;
    }

    if (selectedPhoto.size > 12 * 1024 * 1024) {
      alert("اختار صورة أقل من 12 ميجابايت.");
      return;
    }

    const reader = new FileReader();

    reader.onerror = () => alert("تعذرت قراءة الصورة.");

    reader.onload = () => {
      const img = new Image();

      img.onerror = () => alert("تعذرت قراءة الصورة.");

      img.onload = () => {
        const c = document.createElement("canvas");
        const scale = Math.min(1, 900 / Math.max(img.width, img.height));

        c.width = Math.max(1, Math.round(img.width * scale));
        c.height = Math.max(1, Math.round(img.height * scale));

        const ctx = c.getContext("2d");
        if (!ctx) {
          alert("المتصفح لم يستطع معالجة الصورة.");
          return;
        }

        ctx.drawImage(img, 0, 0, c.width, c.height);

        let data;
        try {
          data = c.toDataURL("image/jpeg", 0.7);
        } catch {
          alert("تعذّر تجهيز الصورة.");
          return;
        }

        const date = val("photoDate") || today();
        if (!validDate(date)) {
          alert("اختار تاريخ صورة صحيح.");
          return;
        }

        const next = [...photos, { id: uid(), date, data }];

        if (persistPhotos(next)) {
          selectedPhoto = null;
          $("photoFile").value = "";
          renderPhotos();
          alert("تمت إضافة الصورة.");
        }
      };

      img.src = reader.result;
    };

    reader.readAsDataURL(selectedPhoto);
  });

  $("photos").addEventListener("click", e => {
    const btn = e.target.closest("[data-photo]");
    if (!btn || !confirm("تحذف الصورة؟")) return;

    const next = photos.filter(p => p.id !== btn.dataset.photo);
    if (persistPhotos(next)) renderPhotos();
  });

  $("export").addEventListener("click", () => {
    try {
      const blob = new Blob(
        [JSON.stringify({ version: 1, records, photos }, null, 2)],
        { type: "application/json;charset=utf-8" }
      );

      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "bodyreset-progress.json";
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1500);
    } catch (error) {
      console.error(error);
      alert("تعذّر تصدير النسخة الاحتياطية.");
    }
  });

  $("importBtn").addEventListener("click", () => $("importFile").click());

  function validRecord(r) {
    return r && typeof r === "object" &&
      typeof r.id === "string" &&
      validDate(r.date) &&
      Number.isFinite(Number(r.weight)) &&
      Number(r.weight) >= 1 &&
      Number(r.weight) <= 500 &&
      (r.fat == null || (Number.isFinite(Number(r.fat)) && Number(r.fat) >= 0 && Number(r.fat) <= 100)) &&
      (r.waist == null || (Number.isFinite(Number(r.waist)) && Number(r.waist) > 0)) &&
      (r.chest == null || (Number.isFinite(Number(r.chest)) && Number(r.chest) > 0)) &&
      (r.arm == null || (Number.isFinite(Number(r.arm)) && Number(r.arm) > 0)) &&
      (r.thigh == null || (Number.isFinite(Number(r.thigh)) && Number(r.thigh) > 0)) &&
      typeof (r.notes ?? "") === "string";
  }

  function validPhoto(p) {
    return p && typeof p === "object" &&
      typeof p.id === "string" &&
      validDate(p.date) &&
      typeof p.data === "string" &&
      /^data:image\/(jpeg|png|webp|gif);base64,/.test(p.data);
  }

  $("importFile").addEventListener("change", async e => {
    const file = e.target.files[0];
    if (!file) return;

    try {
      if (file.size > 30 * 1024 * 1024) {
        throw new Error("حجم ملف النسخة أكبر من 30 ميجابايت.");
      }

      const data = JSON.parse(await file.text());

      if (!data || !Array.isArray(data.records) || !Array.isArray(data.photos)) {
        throw new Error("شكل ملف النسخة غير صحيح.");
      }

      if (!data.records.every(validRecord) || !data.photos.every(validPhoto)) {
        throw new Error("النسخة تحتوي على بيانات غير صالحة.");
      }

      if (new Set(data.records.map(r => r.id)).size !== data.records.length) {
        throw new Error("يوجد تكرار في معرّفات التسجيلات.");
      }

      if (new Set(data.photos.map(p => p.id)).size !== data.photos.length) {
        throw new Error("يوجد تكرار في معرّفات الصور.");
      }

      if (!confirm("النسخة الاحتياطية هتستبدل البيانات الحالية. صدّرت نسخة من بياناتك الحالية؟ تكمل؟")) {
        return;
      }

      const oldR = localStorage.getItem(KEY);
      const oldP = localStorage.getItem(PHOTO_KEY);

      try {
        localStorage.setItem(KEY, JSON.stringify(data.records));
        localStorage.setItem(PHOTO_KEY, JSON.stringify(data.photos));
      } catch (error) {
        if (oldR === null) localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, oldR);

        if (oldP === null) localStorage.removeItem(PHOTO_KEY);
        else localStorage.setItem(PHOTO_KEY, oldP);

        throw error;
      }

      records = data.records;
      photos = data.photos;
      reset();
      render();
      alert("تم استيراد النسخة بنجاح.");
    } catch (error) {
      console.error(error);
      alert(error.message && error.message !== "Unexpected end of JSON input"
        ? error.message
        : "ملف النسخة غير صالح أو مساحة التخزين ممتلئة.");
    } finally {
      e.target.value = "";
    }
  });

  window.addEventListener("resize", drawChart);

  reset();
  render();
  requestAnimationFrame(drawChart);
})();
</script>
</body>
</html>
